BRIDGEAI_ENV=local_dev
BRIDGEAI_API_VERSION=0.2.0
BRIDGEAI_AGENT_MODEL_ID=DeepSeek-V4-Flash-4bit
BRIDGEAI_AGENT_MODEL_VERSION=omlx-current
BRIDGEAI_AGENT_MODEL_ALIAS=omlx-deepseek-v4-flash
BRIDGEAI_AGENT_MODEL_PROVIDER=omlx
BRIDGEAI_AGENT_MODEL_RUNTIME=openai-compatible
BRIDGEAI_AGENT_API_BASE_URL=https://omlx.cpolar.cn/v1
BRIDGEAI_AGENT_API_KEY=replace-with-your-local-key
BRIDGEAI_AGENT_MODEL_TIMEOUT_SECONDS=60
BRIDGEAI_AGENT_MODEL_IS_STUB=false
BRIDGEAI_DATABASE_URL=postgresql://bridgeai:bridgeai@localhost:5432/bridgeai
LANGGRAPH_STRICT_MSGPACK=true
BRIDGEAI_OBJECT_STORE_ENDPOINT=http://localhost:9000
BRIDGEAI_VECTOR_STORE_URL=http://localhost:6333
